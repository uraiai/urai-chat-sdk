{
  "name": "@uraiai/chat-widget-core",
  "version": "0.2.0",
  "description": "Framework-agnostic engine for the Urai chat widget",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dompurify": "^3.2.0",
    "marked": "^16.0.0"
  },
  "devDependencies": {
    "@uraiai/chat-test-support": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "urai",
    "chat",
    "widget",
    "chatbot"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/uraiai/urai-chat-sdk",
    "directory": "packages/chat-widget-core"
  }
}
